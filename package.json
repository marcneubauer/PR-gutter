{
  "name": "pr-gutter",
  "displayName": "PR Gutter",
  "description": "Shows git diff highlighting in the gutter between current branch and a configurable target branch",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/pr-gutter.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:pr-gutter.setTargetBranch",
    "onCommand:pr-gutter.refreshDiff",
    "onCommand:pr-gutter.showDebugInfo"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pr-gutter.setTargetBranch",
        "title": "Set Target Branch",
        "category": "PR Gutter"
      },
      {
        "command": "pr-gutter.refreshDiff",
        "title": "Refresh Diff",
        "category": "PR Gutter"
      },
      {
        "command": "pr-gutter.showDebugInfo",
        "title": "Show Debug Info",
        "category": "PR Gutter"
      }
    ],
    "configuration": {
      "title": "PR Gutter",
      "properties": {
        "pr-gutter.targetBranch": {
          "type": "string",
          "default": "main",
          "description": "The target branch to compare against"
        },
        "pr-gutter.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh diff when files change"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.7.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "simple-git": "^3.30.0"
  }
}
